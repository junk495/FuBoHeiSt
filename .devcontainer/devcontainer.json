// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "FuBoHeiSt",

	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	"image": "mcr.microsoft.com/devcontainers/base:resolute",

	// Netz-Haertung: erlaubt iptables-Regeln im Container (Internet ja, Heimnetz nein)
	"runArgs": ["--cap-add=NET_ADMIN"],

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		// Node.js (via nvm) + npm + pnpm
		"ghcr.io/devcontainers/features/node:2": {
			"version": "lts"
		},
		// Python (system version of the image) + pip + venv
		"ghcr.io/devcontainers/features/python:1": {
			"version": "os-provided"
		},
		// Zsh, Git, jq, curl, wget, ripgrep, ... and a passwordless-sudo user
		"ghcr.io/devcontainers/features/common-utils:2": {
			"installZsh": true,
			"configureZshAsDefaultShell": true,
			"upgradePackages": true,
			"username": "automatic",
			"sudoers": true
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [3000, 8000, 8080],

	// Cline-Verlaeufe pro Projekt dauerhaft sichern (ueberleben Rebuilds).
	// Jedes Projekt bekommt automatisch ein eigenes Volume anhand des
	// Ordnernamens. So bleiben die Chats nur in diesem Projekt erhalten.
	//
	// platformio-core-Volume: persistente PlatformIO-Installation
	// (~/.platformio mit Core, espressif32-Plattform, Toolchain ~3,8 GB und
	// Arduino-Framework). Ohne dieses Volume muesste die Toolchain bei jedem
	// Rebuild neu geladen werden (~7 min). Das Volume enthaelt den
	// PlatformIO-Core der pioarduino-Extension UND den Core fuer das
	// Terminal -> beide teilen sich denselben Paket-Cache.
	"mounts": [
		"source=cline-history-${localWorkspaceFolderBasename},target=/home/vscode/.cline,type=volume",
		"source=platformio-core-${localWorkspaceFolderBasename},target=/home/vscode/.platformio,type=volume"
	],

	// Use 'postCreateCommand' to run commands after the container is created.
	// Laeuft nach jedem Rebuild. Das Skript ist idempotent: es installiert nur
	// fehlende Komponenten und laeuft bei vorhandenem Volume in Sekunden durch.
	"postCreateCommand": "bash .devcontainer/setup.sh",

	// Netz-Haertung: Internet erlauben, Heimnetz/LAN blockieren (laeuft bei jedem Start)
	"postStartCommand": "bash -c 'sudo iptables -N CLINE_NETGUARD 2>/dev/null; sudo iptables -F CLINE_NETGUARD; sudo iptables -C OUTPUT -j CLINE_NETGUARD 2>/dev/null || sudo iptables -I OUTPUT 1 -j CLINE_NETGUARD; sudo iptables -A CLINE_NETGUARD -o lo -j ACCEPT; sudo iptables -A CLINE_NETGUARD -p udp --dport 53 -j ACCEPT; sudo iptables -A CLINE_NETGUARD -p tcp --dport 53 -j ACCEPT; sudo iptables -A CLINE_NETGUARD -d 172.17.0.0/16 -j ACCEPT; sudo iptables -A CLINE_NETGUARD -d 192.168.1.144/32 -p tcp --dport 3000 -j ACCEPT; sudo iptables -A CLINE_NETGUARD -d 192.168.1.144/32 -p tcp --dport 22 -j ACCEPT; sudo iptables -A CLINE_NETGUARD -d 192.168.0.0/16 -j REJECT; sudo iptables -A CLINE_NETGUARD -d 10.0.0.0/8 -j REJECT; sudo iptables -A CLINE_NETGUARD -d 172.16.0.0/12 -j REJECT'",

	// ---------------------------------------------------------------------------
	// Verbindung zu einem lokalen Ordner
	// ---------------------------------------------------------------------------
	// Standardmaessig wird der Ordner, den du in VS Code geoeffnet hast, bereits
	// eingebunden. In dieser Umgebung ist /workspaces/ubuntu allerdings ein
	// Docker-Volume (siehe README.md).
	//
	// Wenn du stattdessen ein echtes Bind-Mount deines lokalen Ordners willst,
	// entferne die Kommentare der beiden folgenden Zeilen:
	//
	// "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/projekt,type=bind,consistency=cached",
	// "workspaceFolder": "/workspaces/projekt"

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
			"extensions": [
				"saoudrizwan.claude-dev", // Cline (KI-Agent)
				"ms-python.python",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode",
				"pioarduino.pioarduino-ide", // PlatformIO-Fork fuer Espressif/ESP32
				"jason2866.esp-decoder", // ESP32-Crash-Decoder (Guru Meditation)
				"ms-vscode.cpptools" // C/C++-IntelliSense-Backend (pflicht seit pioarduino 1.4)
			],
			"settings": {
				"python.defaultInterpreterPath": "/usr/bin/python3",
				"terminal.integrated.defaultProfile.linux": "zsh",
				// pioarduino nutzt den Built-in-Core in ~/.platformio/penv.
				// WICHTIG: Der Core braucht Python 3.13 (uv-venv), NICHT das
				// System-Python 3.14 - daher legt setup.sh das penv selbst an.
				// Mit useBuiltinPIOCore=false sucht die Extension nur nach
				// exakt Python 3.13 im System und faellt sonst aus.
				"platformio-ide.useBuiltinPIOCore": true,
				"platformio-ide.useBuiltinPython": true,
				"platformio-ide.disablePIOHomeStartup": true,
				"platformio-ide.intelliSenseEngine": "cpptools",
				// ESP-Crash-Decoder: Baudrate passend zur Firmware (platformio.ini)
				"esp-decoder.defaultBaudRate": 115200
			}
		}
	}

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
